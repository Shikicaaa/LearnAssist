[importlinter]
root_package = app

[importlinter:contract:shared-is-a-base-layer]
name = shared does not depend on modules
type = forbidden
source_modules =
    app.shared
forbidden_modules =
    app.modules

[importlinter:contract:leaf-modules-depend-on-nothing]
name = auth, jobs and embeddings do not depend on other modules
type = forbidden
source_modules =
    app.modules.auth
    app.modules.jobs
    app.modules.embeddings
forbidden_modules =
    app.modules.sessions
    app.modules.sources
    app.modules.llm
    app.modules.retrieval
    app.modules.cache
    app.modules.chat

[importlinter:contract:sessions-below-the-rest]
name = sessions depends only on auth
type = forbidden
source_modules =
    app.modules.sessions
forbidden_modules =
    app.modules.sources
    app.modules.jobs
    app.modules.embeddings
    app.modules.llm
    app.modules.retrieval
    app.modules.cache
    app.modules.chat

[importlinter:contract:llm-is-self-contained]
name = llm depends only on auth (public interface)
type = forbidden
source_modules =
    app.modules.llm
forbidden_modules =
    app.modules.sessions
    app.modules.sources
    app.modules.jobs
    app.modules.embeddings
    app.modules.retrieval
    app.modules.cache
    app.modules.chat
    app.modules.auth.*
allow_indirect_imports = True

[importlinter:contract:sources-below-retrieval-and-chat]
name = sources does not depend on llm, retrieval, cache or chat; public APIs only
type = forbidden
source_modules =
    app.modules.sources
forbidden_modules =
    app.modules.llm
    app.modules.retrieval
    app.modules.cache
    app.modules.chat
    app.modules.auth.*
    app.modules.sessions.*
    app.modules.jobs.*
    app.modules.embeddings.*
allow_indirect_imports = True

[importlinter:contract:retrieval-reads-chunks-only-through-sources]
name = retrieval uses embeddings and sources through their public interfaces
type = forbidden
source_modules =
    app.modules.retrieval
forbidden_modules =
    app.modules.chat
    app.modules.cache
    app.modules.llm
    app.modules.jobs
    app.modules.sessions
    app.modules.auth
    app.modules.sources.*
    app.modules.embeddings.*
allow_indirect_imports = True

[importlinter:contract:chat-reaches-chunks-only-through-retrieval]
name = chat does not touch sources or jobs, and imports public interfaces only
type = forbidden
source_modules =
    app.modules.chat
forbidden_modules =
    app.modules.sources
    app.modules.jobs
    app.modules.auth.*
    app.modules.sessions.*
    app.modules.llm.*
    app.modules.retrieval.*
    app.modules.cache.*
    app.modules.embeddings.*
allow_indirect_imports = True

[importlinter:contract:cache-sits-between-retrieval-and-chat]
name = cache uses retrieval, sessions and auth through their public interfaces only
type = forbidden
source_modules =
    app.modules.cache
forbidden_modules =
    app.modules.chat
    app.modules.llm
    app.modules.jobs
    app.modules.sources
    app.modules.retrieval.*
    app.modules.embeddings.*
    app.modules.sessions.*
    app.modules.auth.*
allow_indirect_imports = True

[importlinter:contract:sessions-uses-public-apis-only]
name = sessions imports only the public interface of auth
type = forbidden
source_modules =
    app.modules.sessions
forbidden_modules =
    app.modules.auth.*
allow_indirect_imports = True

[importlinter:contract:artifacts-use-public-apis-only]
name = artifacts does not touch chat, cache or sources, and imports public interfaces only
type = forbidden
source_modules =
    app.modules.artifacts
forbidden_modules =
    app.modules.chat
    app.modules.cache
    app.modules.sources
    app.modules.auth.*
    app.modules.sessions.*
    app.modules.jobs.*
    app.modules.embeddings.*
    app.modules.retrieval.*
    app.modules.llm.*
allow_indirect_imports = True

[importlinter:contract:nothing-depends-on-artifacts]
name = artifacts is a top-level feature: no other module imports it
type = forbidden
source_modules =
    app.modules.auth
    app.modules.sessions
    app.modules.jobs
    app.modules.embeddings
    app.modules.llm
    app.modules.sources
    app.modules.retrieval
    app.modules.cache
    app.modules.chat
forbidden_modules =
    app.modules.artifacts
allow_indirect_imports = True
