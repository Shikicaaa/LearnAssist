[importlinter]
root_package = app

[importlinter:contract:shared-is-a-base-layer]
name = shared ne zavisi od modula
type = forbidden
source_modules =
    app.shared
forbidden_modules =
    app.modules

[importlinter:contract:auth-depends-on-nothing]
name = auth ne zavisi od drugih modula
type = forbidden
source_modules =
    app.modules.auth
forbidden_modules =
    app.modules.sessions

[importlinter:contract:sessions-uses-auth-public-api-only]
name = sessions uvozi samo javni interfejs auth modula
type = forbidden
source_modules =
    app.modules.sessions
forbidden_modules =
    app.modules.auth.api
    app.modules.auth.models
    app.modules.auth.repository
    app.modules.auth.schemas
    app.modules.auth.security
    app.modules.auth.service
allow_indirect_imports = True
